# Coursework, kept on disk but out of the repository.
# The marked reports, submission archives and earlier phase folders live
# locally. They are not part of the application and nobody reading the code
# needs them.
Phase 2/
Phase 3/
Phase 4/
Phase 5/
Phase_1/
*.docx
*.pdf
*.zip
*.ipynb
.ipynb_checkpoints/
.docx_work/
.notebook_work/

# The raw data.
# The pipeline downloads about 18 GB of play-by-play and shift charts, and
# building the feature table from it produces a further 17 MB of CSV. Both are
# reproducible with `python main.py --mode historical` in pipeline/, so
# neither belongs in a repository.
pipeline/data/
pipeline/logs/
pipeline/reports/
ml/data/model_dataset.csv

# Secrets: passwords, tokens and Azure publish profiles. Never commit these.
.secrets/
*.env
.env

# Databases created at run time.
*.db
*.db-wal
*.db-shm
web/instance/

# Test and lint caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated output.
model/refresh_payload.json
model/*.log
ml/*.log

